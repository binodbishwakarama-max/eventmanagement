# DSU CAMPUS EVENTS — CLIENT ENVIRONMENT CONFIGURATION
# In production single-port deployment, /api will proxy/route to the backend on the same host.
VITE_API_URL=/api

# Set to 'false' for official Dayananda Sagar University deployment (hides demo disclaimer banners and test account buttons)
# Set to 'true' for local development, reviewer preview, or capstone evaluation
VITE_DEMO_MODE=false
