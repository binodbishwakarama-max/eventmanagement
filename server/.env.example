# =========================================================================
# DSU CAMPUS EVENTS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and supply actual deployment values.
# NEVER commit .env to version control.
# =========================================================================

# Networking & Environment
NODE_ENV=production
PORT=5001
ALLOW_LOCAL_FALLBACK=false
TRUST_PROXY=true

# Institutional Operation Mode:
# Set DEMO_MODE=false for official Dayananda Sagar University deployment (removes demo disclaimers and test pre-fills).
# Set DEMO_MODE=true for sandbox/testing/demo mode.
DEMO_MODE=false

# Allowed institutional email domains for student/faculty registration (comma-separated).
ALLOWED_EMAIL_DOMAINS=dsu.edu.in

# Database: MongoDB Atlas or Containerized Connection String
# For production: mongodb+srv://<USER>:<PASS>@<CLUSTER>.mongodb.net/<DB>?retryWrites=true&w=majority
# For docker-compose: mongodb://mongo:27017/dsu_events
MONGODB_URI=mongodb://127.0.0.1:27017/dsu_events

# Cryptographic Token Secret (Minimum 32 Characters, generate via: openssl rand -hex 32)
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d

# Allowed Web Origins (comma-separated for multiple domains)
# When served as a monolith on the same domain, set to your canonical domain or leave blank.
CLIENT_ORIGIN=http://localhost:5173,https://events.dsu.edu.in

# Production Administrator Credentials (Must be >= 12 chars in production)
ADMIN_EMAIL=admin@dsu.edu.in
ADMIN_PASSWORD=ChangeThisSecurePassword123!

# Storage Provider: 'local' (filesystem) | 'cloudinary' (cloud CDN) | 's3'
STORAGE_PROVIDER=local
MAX_UPLOAD_SIZE_MB=5

# Cloudinary CDN Credentials (Required if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Provider: 'mock' (logs to console in dev) | 'smtp' | 'sendgrid'
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@dsu.edu.in
SMTP_PASS=app-specific-password
SMTP_FROM=DSU Campus Events <no-reply@dsu.edu.in>
SENDGRID_API_KEY=

# Application Performance Monitoring (Optional)
SENTRY_DSN=
