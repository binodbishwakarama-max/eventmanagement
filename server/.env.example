# =========================================================================
# DSU CAMPUS EVENTS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and supply actual deployment values.
# NEVER commit .env to version control.
# =========================================================================

# Networking & Environment
NODE_ENV=development
PORT=5000
ALLOW_LOCAL_FALLBACK=true

# Database: MongoDB Atlas Connection String
# For production: mongodb+srv://<USER>:<PASS>@<CLUSTER>.mongodb.net/<DB>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/dsu_events

# Cryptographic Token Secret (Minimum 32 Characters, generate via: openssl rand -hex 32)
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d

# Allowed Web Origins (comma-separated for multiple domains)
CLIENT_ORIGIN=http://localhost:5173

# Initial Master Administrator (Minimum 12 Characters in production)
ADMIN_EMAIL=registrar.desk@dsu.edu.in
ADMIN_PASSWORD=replace-with-secure-admin-pass-12-chars

# Storage Provider: 'local' (filesystem) | 'cloudinary' (cloud CDN) | 's3'
STORAGE_PROVIDER=local
MAX_UPLOAD_SIZE_MB=5

# Cloudinary CDN Credentials (Required if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Provider: 'mock' (logs to console in dev) | 'smtp' | 'sendgrid'
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DSU Campus Events <no-reply@dsu.edu.in>
SENDGRID_API_KEY=

# Application Performance Monitoring (Optional)
SENTRY_DSN=
